generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  price       Int
  salePrice   Int?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  image       String
  images      String    @default("[]")
  sizes       String    @default("[]")
  colors      String    @default("[]")
  stock       Int       @default(0)
  featured    Boolean   @default(false)
  status      String    @default("active")
  occasion    String?
  gender      String    @default("unisex")
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  state         String
  country       String     @default("Nigeria")
  subtotal      Int
  shipping      Int         @default(0)
  total         Int
  status        String      @default("pending")
  paymentStatus String      @default("pending")
  paymentMethod String?
  notes         String?
  items         String
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
  size      String?
  color     String?
  image     String?
}

model Content {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}
